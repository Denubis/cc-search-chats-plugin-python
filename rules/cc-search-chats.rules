# cc-search-chats depends on host PostgreSQL and, for semantic search, the host
# GPU and model cache. A sandbox result is evidence about that process only.
# The operator authorizes every CLI subcommand to run in that host environment.
prefix_rule(
    pattern=["cc-search-chats"],
    decision="allow",
    justification="Run chat-history commands with host PostgreSQL, systemd, model-cache, and GPU access.",
    match=[
        "cc-search-chats search PABAI --json",
        "cc-search-chats extract 019example --json",
        "cc-search-chats list --days 7 --json",
        "cc-search-chats index --status --json",
    ],
)
