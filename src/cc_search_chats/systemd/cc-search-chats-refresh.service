[Unit]
Description=Refresh the coherent cc-search-chats corpus

[Service]
Type=oneshot
ExecStart=%h/.local/bin/cc-search-chats index --background-refresh
EnvironmentFile=-%h/.config/cc-search-chats/index.env
Environment=CC_SEARCH_CONTAINED=1
Nice=10
IOSchedulingClass=idle
CPUWeight=25
IOWeight=25
MemoryHigh=2G
MemoryMax=4G
MemorySwapMax=1G
TasksMax=64
